# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Tools
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.mypy_cache/

# Streamlit secrets (never commit)
.streamlit/secrets.toml

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local data: never commit real data. Test fixtures are fake and live in tests/fixtures/.
*.csv
*.xlsx
!tests/fixtures/*.csv
!tests/fixtures/*.xlsx
# Profiles written next to the fixtures (e.g. by export_profile) are outputs.
tests/fixtures/*_profile.csv
tests/fixtures/*_profile.xlsx
